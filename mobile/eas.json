{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "API_BASE_URL": "http://10.0.2.2:3000"
      }
    },
    "test": {
      "distribution": "internal",
      "channel": "test",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging"
      },
      "credentialsSource": "remote"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "ANDROID_PACKAGE": "__SET_AT_BUILD__",
        "API_BASE_URL": "__SET_AT_BUILD__",
        "APP_KEY": "__SET_AT_BUILD__"
      },
      "credentialsSource": "remote",
      "prebuildCommand": "expo prebuild --platform android && node scripts/check-play-manifest.cjs"
    }
  },
  "submit": {
    "production": {}
  }
}
