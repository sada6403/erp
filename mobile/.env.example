# Copy to .env.development (git-ignored). None of these are secrets: the App Key only identifies the company.
ANDROID_PACKAGE=com.naturalplantation.app.dev
API_BASE_URL=http://10.0.2.2:3000
APP_KEY=
APP_ENV=development
# 1 = serve src/dev mock data (only honoured in __DEV__ builds). Default: on for APP_ENV=development.
USE_MOCKS=
EAS_PROJECT_ID=
EAS_UPDATE_URL=
# Path to google-services.json (FCM), kept out of the repo.
GOOGLE_SERVICES_FILE=
