NODE_ENV=development
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Email (SMTP) & SMS — optional. Override whatever's configured in
# Admin > Settings > Email/SMS on this device. Leave unset to keep using the
# Settings UI values (each company enters their own on their own machine —
# nothing here is required, and nothing here should ever be committed with
# real values). See electron/services/emailService.ts / smsService.ts.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=TLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=POS System
# SMTP_REPLY_TO=
# SMS_ENABLED=true
# SMS_PROVIDER_NAME=
# SMS_API_BASE_URL=
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=
# SMS_HTTP_METHOD=POST
# SMS_CONTENT_TYPE=application/json
# SMS_CUSTOM_HEADERS=
# SMS_BODY_TEMPLATE={"mobile":"{phone}","message":"{message}"}
